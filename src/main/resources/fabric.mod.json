{
  "schemaVersion": 1,
  "id": "pw_groundworks",
  "version": "${version}",
  "name": "Peterwolf's Groundworks",
  "description": "Volumetric deformable granular terrain engine for Minecraft.",
  "authors": ["Piotrek"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.piotrek.groundworks.GroundworksMod"],
    "client": ["com.piotrek.groundworks.client.GroundworksClient"]
  },
  "mixins": [
    {
      "config": "pw_groundworks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
